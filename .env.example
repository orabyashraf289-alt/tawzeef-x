# -----------------------------------------------------------------------------
# Tawzeef-X Frontend Environment Variables
# -----------------------------------------------------------------------------

# Supabase Project URL (e.g., https://your-project-id.supabase.co)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Publishable / Anonymous Key
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"

# Optional: Dedicated App Domain / Base URL for production
VITE_APP_BASE_URL="https://app.tawzeefx.com"

# -----------------------------------------------------------------------------
# Supabase Edge Functions Secrets (Set in Supabase Dashboard / Vault)
# -----------------------------------------------------------------------------

# SUPABASE_URL="https://your-project-id.supabase.co"
# SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AI Model Provider Keys
# OPENAI_API_KEY="sk-..."
# GEMINI_API_KEY="..."
# ELEVENLABS_API_KEY="..."

# CRON Security Secret (for automated background tasks like interview reminders)
# CRON_SECRET="your-secure-cron-secret-key"

# SMTP Configuration (Optional if using Supabase Auth SMTP or custom send-email)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="notifications@tawzeefx.com"
# SMTP_PASS="your-smtp-password"
